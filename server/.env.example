# TuniVisa chat API environment variables.
# Set these in the Vercel project (Project Settings -> Environment Variables).

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=https://oussema-mhiri.github.io,http://localhost:5173

# Optional Upstash Redis REST credentials for rate limiting and response caching.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Per-provider timeout in milliseconds (default 11000).
PROVIDER_TIMEOUT_MS=11000

# Set to true only for local testing. Do not disable rate limiting in production.
RATE_LIMIT_DISABLED=false
