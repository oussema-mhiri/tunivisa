{
  "name": "tunivisa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "description": "TuniVisa — visa & travel assistant for Tunisian passport holders",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:knowledge": "node scripts/build-chat-knowledge.mjs",
    "preview": "vite preview",
    "sync:visa": "node scripts/sync-visa-data.mjs",
    "sync:visa:check": "node scripts/sync-visa-data.mjs --check",
    "test": "npm run test:server && npm run test:app",
    "test:server": "node --test server/lib/retrieval.test.js server/lib/providers/shared.test.js server/lib/validate.test.js server/lib/stream.test.js server/lib/prompt.test.js server/lib/cache.test.js",
    "test:app": "node --test src/utils/compare.test.js src/utils/chatHistory.test.js src/data/tourism.test.js src/i18n/translations.test.js"
  },
  "dependencies": {
    "framer-motion": "^13.1.0",
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.1.1",
    "react-simple-maps": "3.0.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7"
  }
}
