# Base environment variables for TuniVisa.
# Copy this file to `.env` and adjust if needed. Vite exposes only `VITE_*` vars.

# When a Node.js + Express backend is deployed, point the frontend at its base URL.
VITE_API_URL=http://localhost:4000/api

# Set to "false" to call the real REST API instead of the bundled mock data.
VITE_USE_MOCK=true

# Base URL of the TuniVisa chat API (Vercel project with Root Directory = server).
# Leave empty in GitHub Pages builds to hide the chat widget.
VITE_CHAT_API_URL=http://localhost:3000/api

# Chat backend (local, no deployment): configure provider keys in server/.env (see server/.env.example).
# GEMINI_API_KEY is required; GROQ_API_KEY is recommended as fallback.
