# Base environment variables for TuniVisa.
# Copy this file to `.env` and adjust if needed. Vite exposes only `VITE_*` vars.

# When a Node.js + Express backend is deployed, point the frontend at its base URL.
VITE_API_URL=http://localhost:4000/api

# Set to "false" to call the real REST API instead of the bundled mock data.
VITE_USE_MOCK=true
